{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch-plan.schema.json",
  "title": "LaunchPlan",
  "type": "object",
  "required": ["session", "repoDir", "baseBranch", "worktreeRoot", "agentCmd", "tasks"],
  "additionalProperties": true,
  "properties": {
    "session": {
      "type": "string",
      "description": "Wavemill session identifier"
    },
    "repoDir": {
      "type": "string",
      "description": "Repository root directory path"
    },
    "baseBranch": {
      "type": "string",
      "description": "Git base branch for worktrees"
    },
    "worktreeRoot": {
      "type": "string",
      "description": "Root directory for git worktrees"
    },
    "agentCmd": {
      "type": "string",
      "description": "Default agent command (e.g., 'claude')"
    },
    "tasks": {
      "type": "array",
      "description": "Tasks to launch in this session",
      "items": {
        "type": "object",
        "required": ["issue", "slug", "branch"],
        "additionalProperties": true,
        "properties": {
          "issue": {
            "type": "string",
            "description": "Issue ID (e.g., 'HOK-1532')"
          },
          "slug": {
            "type": "string",
            "description": "Issue slug for branch naming"
          },
          "branch": {
            "type": "string",
            "description": "Git branch name"
          },
          "model": {
            "type": "string",
            "description": "Workspace-declared model selector for this task. Accepts 'inherit', a family alias (e.g. 'opus'), or a pinned model ID. Validated by the loader; absent means defer to routing defaults."
          },
          "parentResolvedModel": {
            "type": "string",
            "description": "Concrete resolved model ID from the parent context, used to resolve 'inherit' selectors for this task across worktree or process boundaries."
          },
          "dependsOn": {
            "type": "array",
            "description": "Task IDs this task depends on (HOK-1532)",
            "items": {
              "type": "string"
            }
          },
          "baseFromTask": {
            "type": ["string", "null"],
            "description": "Task ID to base branch from, or null (HOK-1532)"
          },
          "depends_on_pr": {
            "type": "object",
            "description": "Parent PR metadata for dependent task dispatch (HOK-1534)",
            "properties": {
              "number": {
                "type": "integer"
              },
              "url": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "parent_issue": {
                "type": "string"
              }
            }
          },
          "launchReconciliation": {
            "type": "object",
            "description": "Fresh-launch PR reconciliation evidence (HOK-2965)",
            "additionalProperties": true,
            "properties": {
              "classification": {
                "type": "string",
                "enum": ["current-open", "current-merged", "historical-closed", "historical-merged", "unverifiable", "none"]
              },
              "prNumber": {
                "type": "string"
              },
              "prState": {
                "type": "string"
              },
              "checkedAt": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "queuePlan": {
      "type": "object",
      "description": "Planner-supplied wave ordering. Runner ignores; reserved for future queue execution (HOK-1532)."
    }
  }
}
