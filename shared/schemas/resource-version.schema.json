{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-version.schema.json",
  "title": "ResourceVersion",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "contentHash",
    "name",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "prompt",
        "optimizer-artifact",
        "tool",
        "memory",
        "agent-config",
        "environment",
        "runtime"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "uri": {
      "type": "string"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string" },
        "optimizer": { "type": "string" },
        "generatedFrom": {
          "type": "array",
          "items": { "$ref": "#/$defs/resourceRef" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/resourceRef" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "resourceRef": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
