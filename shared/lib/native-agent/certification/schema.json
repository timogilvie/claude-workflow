{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "native-certification-artifact",
  "title": "NativeCertificationArtifact",
  "description": "Native agent certification artifact stored under .wavemill/native-agent-certifications/<provider>/<model>/<suite-version>.json",
  "oneOf": [
    {
      "$ref": "#/$defs/CurrentArtifact"
    },
    {
      "$ref": "#/$defs/HistoricalV2Artifact"
    }
  ],
  "$defs": {
    "CurrentArtifact": {
      "type": "object",
      "required": [
        "schemaVersion",
        "subject",
        "provider",
        "model",
        "phase",
        "suiteVersion",
        "certifiedAt",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 3
        },
        "subject": {
          "$ref": "#/$defs/CertificationSubject"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": ["read-only", "patch", "workflow"]
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "certifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioResult"
          }
        },
        "knownLimitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalRetryCount": {
          "type": "integer",
          "minimum": 0
        },
        "liveSmokeEvidence": {
          "$ref": "#/$defs/LiveSmokeEvidence"
        }
      }
    },
    "HistoricalV2Artifact": {
      "type": "object",
      "required": [
        "schemaVersion",
        "provider",
        "model",
        "phase",
        "suiteVersion",
        "certifiedAt",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 2
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": ["read-only", "patch", "workflow"]
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "certifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioResult"
          }
        },
        "knownLimitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalRetryCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CertificationSubject": {
      "type": "object",
      "required": [
        "registryKey",
        "nativeProvider",
        "providerId",
        "providerModelId",
        "providerNativeId",
        "identityRevision",
        "identityFingerprint",
        "catalogHash"
      ],
      "additionalProperties": false,
      "properties": {
        "registryKey": {
          "type": "string",
          "minLength": 1
        },
        "nativeProvider": {
          "type": "string",
          "minLength": 1
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "providerModelId": {
          "type": "string",
          "minLength": 1
        },
        "providerNativeId": {
          "type": "string",
          "minLength": 1
        },
        "identityRevision": {
          "type": "integer",
          "minimum": 1
        },
        "identityFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "catalogHash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LiveSmokeEvidence": {
      "type": "object",
      "required": ["requestedWireId", "catalogHash", "succeededAt"],
      "additionalProperties": false,
      "properties": {
        "requestedWireId": {
          "type": "string",
          "minLength": 1
        },
        "providerReturnedModel": {
          "type": "string",
          "minLength": 1
        },
        "catalogHash": {
          "type": "string",
          "minLength": 1
        },
        "succeededAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ScenarioResult": {
      "type": "object",
      "required": ["scenarioId", "passed"],
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "failureMessage": {
          "type": "string"
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "finalAttemptStatus": {
          "type": "string",
          "enum": ["pass", "fail", "unsupported", "provider-flake"]
        },
        "failureClass": {
          "type": "string",
          "enum": ["deterministic_failure", "provider_flake", "unsupported_capability"]
        }
      }
    }
  }
}
