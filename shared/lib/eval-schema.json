{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval-record.schema.json",
  "title": "EvalRecord",
  "description": "A single eval result record capturing the outcome of an autonomous task execution, including the prompt, model, score, timing, and any human interventions.",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "originalPrompt",
    "modelId",
    "modelVersion",
    "score",
    "scoreBand",
    "timeSeconds",
    "timestamp",
    "interventionRequired",
    "interventionCount",
    "interventionDetails",
    "rationale"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this eval record (UUID v4 recommended)."
    },
    "schemaVersion": {
      "type": "string",
      "description": "Schema version for forward compatibility (semver, e.g. \"1.0.0\").",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "originalPrompt": {
      "type": "string",
      "description": "The task prompt that was given to the agent."
    },
    "modelId": {
      "type": "string",
      "description": "Model identifier (e.g. \"claude-opus-4-6\")."
    },
    "modelVersion": {
      "type": "string",
      "description": "Specific model version string for reproducibility."
    },
    "judgeModel": {
      "type": "string",
      "description": "Model ID used by the LLM judge for this eval."
    },
    "judgeProvider": {
      "type": "string",
      "description": "Provider used by the LLM judge for this eval (e.g. 'anthropic')."
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Numeric score between 0 and 1 (inclusive). Preserves full granularity; use scoreBand for human-readable interpretation."
    },
    "scoreBand": {
      "type": "string",
      "enum": [
        "Failure",
        "Partial",
        "Assisted Success",
        "Minor Feedback",
        "Full Success"
      ],
      "description": "The rubric band label derived from the score."
    },
    "timeSeconds": {
      "type": "number",
      "minimum": 0,
      "description": "Wall-clock time in seconds for task completion."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime string when the eval was recorded."
    },
    "interventionRequired": {
      "type": "boolean",
      "description": "Whether any human intervention was required during the task."
    },
    "interventionCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of distinct human interventions during the task."
    },
    "interventionDetails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Brief description of each human intervention (legacy - prefer interventions field)."
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "type", "severity", "note"],
        "additionalProperties": false,
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 datetime when the intervention occurred."
          },
          "type": {
            "type": "string",
            "enum": [
              "clarification",
              "bugfix",
              "manual_merge",
              "environment_fix",
              "prompt_edit",
              "scope_change",
              "rollback"
            ],
            "description": "Type of intervention (reason for human involvement)."
          },
          "severity": {
            "type": "string",
            "enum": ["low", "med", "high"],
            "description": "Severity/impact of the intervention."
          },
          "note": {
            "type": "string",
            "description": "Human-readable description of what was done."
          },
          "timeSpentSeconds": {
            "type": "number",
            "minimum": 0,
            "description": "Optional time spent on this intervention in seconds."
          }
        }
      },
      "description": "Structured intervention events (machine-usable)."
    },
    "rationale": {
      "type": "string",
      "description": "Free-text rationale from the LLM judge explaining the score."
    },
    "issueId": {
      "type": "string",
      "description": "Linear issue identifier (e.g. \"HOK-697\"), if the task was issue-based."
    },
    "challengePairId": {
      "type": "string",
      "description": "Shared identifier linking both sides of a challenge-mode pair."
    },
    "prUrl": {
      "type": "string",
      "format": "uri",
      "description": "Pull request URL, if the task produced a PR."
    },
    "tokenUsage": {
      "type": "object",
      "description": "Token usage from the LLM judge API call.",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of input (prompt) tokens."
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of output (completion) tokens."
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Total tokens (input + output)."
        }
      },
      "required": ["inputTokens", "outputTokens", "totalTokens"],
      "additionalProperties": false
    },
    "estimatedCost": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated cost in USD based on the pricing table."
    },
    "agentType": {
      "type": "string",
      "description": "Agent that produced the work being evaluated (e.g. 'claude', 'codex')."
    },
    "workflowCost": {
      "type": "number",
      "minimum": 0,
      "description": "Total estimated cost in USD to build the feature (all agent sessions on this branch)."
    },
    "workflowTokenUsage": {
      "type": "object",
      "description": "Per-model token usage breakdown from the workflow sessions.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Base input (prompt) tokens."
          },
          "cacheCreationTokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Tokens used to create prompt cache."
          },
          "cacheReadTokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Tokens read from prompt cache."
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Output (completion) tokens."
          },
          "costUsd": {
            "type": "number",
            "minimum": 0,
            "description": "Estimated cost in USD for this model."
          }
        },
        "required": ["inputTokens", "cacheCreationTokens", "cacheReadTokens", "outputTokens", "costUsd"],
        "additionalProperties": false
      }
    },
    "workflowCostStatus": {
      "type": "string",
      "enum": ["success", "no_sessions", "no_branch", "adapter_error", "missing_worktree", "skipped"],
      "description": "Status of workflow cost computation."
    },
    "workflowCostDiagnostics": {
      "type": "object",
      "description": "Diagnostic details when workflowCost is missing or skipped.",
      "properties": {
        "reason": {
          "type": "string",
          "description": "Human-readable explanation for the workflow cost status."
        },
        "worktreePath": {
          "type": "string",
          "description": "Worktree path used for cost lookup, if available."
        },
        "branchName": {
          "type": "string",
          "description": "Branch name used for cost lookup, if available."
        },
        "agentType": {
          "type": "string",
          "description": "Agent type used for cost lookup, if available."
        },
        "sessionFilesFound": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of session files discovered during scan."
        },
        "matchingTurns": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of turns that matched the branch."
        },
        "totalAssistantTurns": {
          "type": "integer",
          "minimum": 0,
          "description": "Total assistant turns inspected."
        },
        "branchMismatches": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of scanned turns rejected due to branch mismatch."
        }
      },
      "required": ["reason"],
      "additionalProperties": false
    },
    "pricingSnapshot": {
      "type": "object",
      "description": "Snapshot of the pricing table used for workflowCost calculation (HOK-858). Maps model IDs to their pricing at the time of evaluation.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inputCostPerMTok": {
            "type": "number",
            "minimum": 0,
            "description": "Cost in USD per million input tokens."
          },
          "outputCostPerMTok": {
            "type": "number",
            "minimum": 0,
            "description": "Cost in USD per million output tokens."
          },
          "cacheWriteCostPerMTok": {
            "type": "number",
            "minimum": 0,
            "description": "Cost in USD per million cache creation (write) input tokens."
          },
          "cacheReadCostPerMTok": {
            "type": "number",
            "minimum": 0,
            "description": "Cost in USD per million cache read input tokens."
          }
        },
        "required": ["inputCostPerMTok", "outputCostPerMTok"],
        "additionalProperties": false
      }
    },
    "difficultyBand": {
      "type": "string",
      "enum": ["trivial", "easy", "medium", "hard", "very_hard"],
      "description": "Difficulty band classification derived from signals."
    },
    "difficultySignals": {
      "type": "object",
      "description": "Quantifiable difficulty metrics computed from PR data.",
      "properties": {
        "locTouched": {
          "type": "integer",
          "minimum": 0,
          "description": "Lines of code touched (additions + deletions)."
        },
        "filesTouched": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of files modified in the PR."
        },
        "dependencyDepth": {
          "type": "integer",
          "minimum": 0,
          "description": "Dependency depth (optional)."
        },
        "testRuntime": {
          "type": "number",
          "minimum": 0,
          "description": "Test runtime in seconds (optional)."
        },
        "moduleHotspotScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Module hotspot score based on git history (optional)."
        }
      },
      "required": ["locTouched", "filesTouched"],
      "additionalProperties": false
    },
    "stratum": {
      "type": "string",
      "description": "Tech stack and size stratum (e.g., 'ts_nextjs_small', 'py_django_med')."
    },
    "routingDecision": {
      "type": "object",
      "description": "Routing decision metadata capturing all candidates considered (required if training routing models).",
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["agentType", "modelId"],
            "additionalProperties": false,
            "properties": {
              "agentType": {
                "type": "string",
                "description": "Agent type (e.g., 'claude', 'codex')."
              },
              "modelId": {
                "type": "string",
                "description": "Model identifier (e.g., 'claude-opus-4-6', 'gpt-5.3-codex')."
              },
              "modelVersion": {
                "type": "string",
                "description": "Specific model version string (optional)."
              },
              "toolsetId": {
                "type": "string",
                "description": "Toolset variant identifier (optional)."
              },
              "priceTier": {
                "type": "string",
                "description": "Price tier classification (e.g., 'low', 'medium', 'high')."
              }
            }
          },
          "description": "All candidate configurations that were eligible for this task."
        },
        "chosen": {
          "oneOf": [
            {
              "type": "object",
              "required": ["agentType", "modelId"],
              "additionalProperties": false,
              "properties": {
                "agentType": {
                  "type": "string",
                  "description": "Agent type (e.g., 'claude', 'codex')."
                },
                "modelId": {
                  "type": "string",
                  "description": "Model identifier (e.g., 'claude-opus-4-6', 'gpt-5.3-codex')."
                },
                "modelVersion": {
                  "type": "string",
                  "description": "Specific model version string (optional)."
                },
                "toolsetId": {
                  "type": "string",
                  "description": "Toolset variant identifier (optional)."
                },
                "priceTier": {
                  "type": "string",
                  "description": "Price tier classification (e.g., 'low', 'medium', 'high')."
                }
              }
            },
            {
              "type": "integer",
              "minimum": 0,
              "description": "Index into the candidates array."
            }
          ],
          "description": "The chosen candidate (full object or index into candidates array)."
        },
        "decisionPolicyVersion": {
          "type": "string",
          "description": "Decision policy version that made this choice (e.g., 'baseline', 'router-v1.0')."
        },
        "decisionRationale": {
          "type": "string",
          "description": "Optional rationale or top features used for the decision."
        }
      },
      "required": ["candidates", "chosen", "decisionPolicyVersion"],
      "additionalProperties": false
    },
    "taskContext": {
      "type": "object",
      "description": "Task context metadata for routing and evaluation (HOK-774).",
      "properties": {
        "taskType": {
          "type": "string",
          "enum": ["bugfix", "feature", "refactor", "chore", "docs", "test", "infra"],
          "description": "Type of task being performed."
        },
        "changeKind": {
          "type": "string",
          "enum": ["modify_existing", "create_new", "mixed"],
          "description": "Whether the task modifies existing code, creates new code, or both."
        },
        "complexity": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Complexity score (0-1)."
            },
            {
              "type": "string",
              "enum": ["xs", "s", "m", "l", "xl"],
              "description": "Complexity band classification."
            }
          ],
          "description": "Complexity score (0-1) or band classification."
        },
        "constraints": {
          "type": "object",
          "description": "Special constraints that apply to this task.",
          "properties": {
            "hasStrictStyle": {
              "type": "boolean",
              "description": "Whether the task requires strict adherence to a style guide."
            },
            "mustNotTouchX": {
              "type": "boolean",
              "description": "Whether the task has modules/files that must not be touched."
            },
            "timeboxed": {
              "type": "boolean",
              "description": "Whether the task is timeboxed with a deadline."
            },
            "noNetAccess": {
              "type": "boolean",
              "description": "Whether the task must be completed without network access."
            }
          },
          "additionalProperties": false
        },
        "filesTouchedEstimate": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated number of files to be touched."
        },
        "expectedLoCChange": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated lines of code to be changed."
        },
        "requiresDomainKnowledge": {
          "oneOf": [
            {
              "type": "string",
              "description": "Domain-specific knowledge required (e.g., 'payments', 'auth', 'k8s')."
            },
            {
              "type": "boolean",
              "description": "Whether domain knowledge is required (boolean form)."
            }
          ],
          "description": "Domain-specific knowledge required."
        }
      },
      "required": ["taskType", "changeKind", "complexity"],
      "additionalProperties": false
    },
    "repoContext": {
      "type": "object",
      "description": "Repository context metadata for routing and evaluation (HOK-774).",
      "properties": {
        "repoId": {
          "type": "string",
          "description": "Stable identifier for the repository (hash or slug)."
        },
        "repoVisibility": {
          "type": "string",
          "enum": ["oss", "private"],
          "description": "Whether the repository is open source or private."
        },
        "primaryLanguage": {
          "type": "string",
          "description": "Primary programming language."
        },
        "languages": {
          "type": "object",
          "description": "Map of language to percentage.",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Frameworks used in the repository."
        },
        "buildSystem": {
          "type": "string",
          "description": "Build system (e.g., 'webpack', 'vite', 'gradle')."
        },
        "packageManager": {
          "type": "string",
          "description": "Package manager (e.g., 'npm', 'yarn', 'pnpm')."
        },
        "testFrameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Test frameworks used."
        },
        "ciProvider": {
          "type": "string",
          "description": "CI provider (e.g., 'github-actions', 'gitlab-ci')."
        },
        "repoSize": {
          "type": "object",
          "description": "Repository size metrics.",
          "properties": {
            "fileCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of files in the repository."
            },
            "loc": {
              "type": "integer",
              "minimum": 0,
              "description": "Total lines of code in the repository."
            },
            "dependencyCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of dependencies (approximate)."
            }
          },
          "required": ["fileCount", "loc", "dependencyCount"],
          "additionalProperties": false
        },
        "monorepo": {
          "type": "boolean",
          "description": "Whether the repository is a monorepo."
        }
      },
      "required": ["repoId", "repoVisibility", "primaryLanguage"],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "description": "Budget constraints applied during routing and execution.",
      "properties": {
        "maxCostUsd": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum routing budget in USD."
        }
      },
      "additionalProperties": false
    },
    "outcomes": {
      "type": "object",
      "description": "Decomposed outcome components for granular eval analysis.",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Hard gate: whether the task succeeded (derived from score)."
        },
        "ci": {
          "type": "object",
          "description": "CI/CD check results.",
          "properties": {
            "ran": {
              "type": "boolean",
              "description": "Whether CI checks were triggered for this PR."
            },
            "passed": {
              "type": "boolean",
              "description": "Whether all CI checks passed."
            },
            "checks": {
              "type": "array",
              "description": "Individual check results.",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Check name (e.g. tests, lint, build)."
                  },
                  "status": {
                    "type": "string",
                    "enum": ["success", "failure", "pending", "skipped", "cancelled"],
                    "description": "Check status."
                  },
                  "durationSeconds": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Check duration in seconds (if available)."
                  }
                },
                "required": ["name", "status"],
                "additionalProperties": false
              }
            }
          },
          "required": ["ran", "passed", "checks"],
          "additionalProperties": false
        },
        "tests": {
          "type": "object",
          "description": "Test additions and results.",
          "properties": {
            "added": {
              "type": "boolean",
              "description": "Whether new test files were added in this PR."
            },
            "passRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Test pass rate (0-1), if test results are available."
            },
            "durationSeconds": {
              "type": "number",
              "minimum": 0,
              "description": "Total test execution time in seconds, if available."
            }
          },
          "required": ["added"],
          "additionalProperties": false
        },
        "staticAnalysis": {
          "type": "object",
          "description": "Static analysis results.",
          "properties": {
            "lintDelta": {
              "type": "number",
              "description": "Change in lint errors (negative = improvement, positive = regression)."
            },
            "typecheckPassed": {
              "type": "boolean",
              "description": "Whether typecheck passed."
            },
            "securityFindingsDelta": {
              "type": "number",
              "description": "Change in security findings (negative = improvement)."
            }
          },
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "description": "Human review activity on the PR.",
          "properties": {
            "humanReviewRequired": {
              "type": "boolean",
              "description": "Whether human review was required (any review comments or changes requested)."
            },
            "rounds": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of distinct review submission rounds."
            },
            "approvals": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of approval reviews."
            },
            "changeRequests": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of change request reviews."
            }
          },
          "required": ["humanReviewRequired", "rounds", "approvals", "changeRequests"],
          "additionalProperties": false
        },
        "rework": {
          "type": "object",
          "description": "Agent rework and failures during implementation.",
          "properties": {
            "agentIterations": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of agent iterations (session turns, commits, or retries)."
            },
            "toolFailures": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of tool/API call failures, if tracked."
            }
          },
          "required": ["agentIterations"],
          "additionalProperties": false
        },
        "delivery": {
          "type": "object",
          "description": "PR delivery status.",
          "properties": {
            "prCreated": {
              "type": "boolean",
              "description": "Whether a PR was created."
            },
            "merged": {
              "type": "boolean",
              "description": "Whether the PR was merged."
            },
            "timeToMergeSeconds": {
              "type": "number",
              "minimum": 0,
              "description": "Time from PR creation to merge in seconds, if merged."
            }
          },
          "required": ["prCreated", "merged"],
          "additionalProperties": false
        }
      },
      "required": ["success", "review", "rework", "delivery"],
      "additionalProperties": false
    },
    "taskDescriptor": {
      "type": "object",
      "description": "Task descriptor for router training (HOK-1120). Consolidates generalizable task features into a privacy-safe structure.",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": ["1.0"],
          "description": "Schema version for forward compatibility."
        },
        "signals": {
          "type": "object",
          "description": "Heuristic and learned feature signals.",
          "properties": {
            "heuristic": {
              "type": "object",
              "description": "Heuristic signals derived from task prompt and PR diff.",
              "properties": {
                "task_type": {
                  "type": "string",
                  "enum": ["bugfix", "feature", "refactor", "chore", "docs", "test", "infra"],
                  "description": "Type of task being performed."
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Programming languages used (from file extensions)."
                },
                "framework_tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Frameworks detected in the codebase."
                },
                "files_touched": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of files modified in the PR."
                },
                "repo_size_loc": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Repository size in lines of code."
                },
                "description_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Approximate token count of task description."
                },
                "is_greenfield": {
                  "type": "boolean",
                  "description": "Whether the task creates new code (vs modifying existing)."
                },
                "has_migration": {
                  "type": "boolean",
                  "description": "Whether the task involves a database migration."
                },
                "has_ui": {
                  "type": "boolean",
                  "description": "Whether the task has UI components."
                },
                "has_tests": {
                  "type": "boolean",
                  "description": "Whether the task adds or modifies tests."
                },
                "cross_service": {
                  "type": "boolean",
                  "description": "Whether the task spans multiple services."
                }
              },
              "required": [
                "task_type",
                "languages",
                "framework_tags",
                "files_touched",
                "repo_size_loc",
                "description_tokens",
                "is_greenfield",
                "has_migration",
                "has_ui",
                "has_tests",
                "cross_service"
              ],
              "additionalProperties": false
            },
            "learned": {
              "type": "object",
              "description": "Learned signals that require classification or embedding.",
              "properties": {
                "complexity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5,
                  "description": "Complexity score 1-5 (mapped from xs/s/m/l/xl bands)."
                },
                "domain": {
                  "type": "string",
                  "description": "Domain classification for the task."
                },
                "risk_flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Risk flags detected in the task."
                },
                "embedding_id": {
                  "type": "string",
                  "description": "Optional vector store reference for nearest-neighbor lookup."
                }
              },
              "required": ["complexity", "domain", "risk_flags"],
              "additionalProperties": false
            }
          },
          "required": ["heuristic", "learned"],
          "additionalProperties": false
        },
        "constraints": {
          "type": "object",
          "description": "Constraints and objectives for task execution.",
          "properties": {
            "max_cost_usd": {
              "type": "number",
              "minimum": 0,
              "description": "Maximum cost budget in USD."
            },
            "max_time_minutes": {
              "type": "number",
              "minimum": 0,
              "description": "Maximum time budget in minutes."
            },
            "models_available": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Models available for routing consideration."
            },
            "objective": {
              "type": "string",
              "enum": ["max_success", "min_cost", "balanced"],
              "description": "Routing objective (maximize success, minimize cost, or balanced)."
            }
          },
          "required": ["models_available", "objective"],
          "additionalProperties": false
        },
        "stages": {
          "type": "object",
          "description": "Per-stage execution details.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "Model identifier used for this stage."
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Quality score 0-1 for this stage (null pre-eval)."
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0,
                "description": "Cost in USD for this stage."
              },
              "time_minutes": {
                "type": "number",
                "minimum": 0,
                "description": "Time spent on this stage in minutes."
              }
            },
            "required": ["model"],
            "additionalProperties": false
          }
        },
        "outcome": {
          "type": "object",
          "description": "Overall task outcome summary (null when used as router input pre-eval).",
          "properties": {
            "overall_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall quality score 0-1."
            },
            "total_cost_usd": {
              "type": "number",
              "minimum": 0,
              "description": "Total workflow cost in USD."
            },
            "total_time_minutes": {
              "type": "number",
              "minimum": 0,
              "description": "Total workflow time in minutes."
            },
            "interventions": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of human interventions required."
            },
            "intervention_types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Types of interventions that occurred."
            }
          },
          "required": ["overall_score", "interventions", "intervention_types"],
          "additionalProperties": false
        }
      },
      "required": ["schema_version", "signals", "constraints", "stages"],
      "additionalProperties": false
    },
    "fallbackEvent": {
      "type": "object",
      "description": "Cross-model fallback telemetry for quota-aware training attribution.",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": ["1.0"],
          "description": "Schema version for the fallback event payload."
        },
        "preferred_model": {
          "type": "string",
          "description": "Model preferred before any fallback occurred."
        },
        "fallback_model": {
          "type": ["string", "null"],
          "description": "Model that ultimately produced the response, or null if none succeeded."
        },
        "task_type": {
          "type": ["string", "null"],
          "enum": ["routing", "planning", "coding", "review", "classify", null],
          "description": "Task type used to select the fallback ladder."
        },
        "difficulty": {
          "type": ["string", "null"],
          "enum": ["trivial", "easy", "medium", "hard", "very_hard", null],
          "description": "Difficulty classification supplied by the caller, when known."
        },
        "quota_snapshot": {
          "type": "object",
          "description": "Quota-state snapshot captured near the fallback event.",
          "properties": {
            "snapshotAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the quota snapshot was read."
            },
            "models": {
              "type": "object",
              "description": "Per-model quota entries at snapshot time.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["healthy", "degrading", "exhausted"],
                    "description": "Current quota status for the model."
                  },
                  "resetAt": {
                    "type": ["string", "null"],
                    "description": "When quota is expected to recover, if known."
                  },
                  "remainingEstimate": {
                    "type": ["number", "null"],
                    "description": "Estimated remaining capacity, if available."
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Confidence in the quota estimate."
                  }
                },
                "required": ["status", "resetAt", "remainingEstimate", "confidence"],
                "additionalProperties": false
              }
            }
          },
          "required": ["snapshotAt", "models"],
          "additionalProperties": false
        },
        "human_intervention": {
          "type": "boolean",
          "description": "Whether a human manually intervened in the fallback path."
        },
        "outcome": {
          "type": "string",
          "enum": ["success", "all_exhausted", "non_quota_error"],
          "description": "Final outcome of the fallback sequence."
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0,
          "description": "End-to-end wall-clock duration across the fallback sequence."
        },
        "cost_usd": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Observed cost in USD across the fallback sequence, if surfaced."
        },
        "fallback_chain": {
          "type": "array",
          "description": "Ordered list of models that failed before success or terminal exit.",
          "items": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "Failed model identifier."
              },
              "reason": {
                "type": "string",
                "description": "Reason that the model was skipped or failed."
              }
            },
            "required": ["model", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "preferred_model",
        "fallback_model",
        "task_type",
        "quota_snapshot",
        "human_intervention",
        "outcome",
        "latency_ms",
        "cost_usd",
        "fallback_chain"
      ],
      "additionalProperties": false
    },
    "manifestRef": {
      "type": "object",
      "description": "Reference to the per-run resource manifest used for this workflow.",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "manifestDigest": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": ["sessionId", "manifestDigest"],
      "additionalProperties": false
    },
    "rubricEval": {
      "type": "object",
      "description": "Structured rubric criteria evaluation from the judge. Captures per-criterion scores as durable training signal. Present only for records produced after schema v1.10.0.",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0",
          "description": "Schema version for this rubricEval shape."
        },
        "rubric_version": {
          "type": "string",
          "description": "Semantic rubric version; bumped when criteria or boundaries change meaningfully."
        },
        "criteria": {
          "type": "object",
          "description": "Per-criterion rubric scores.",
          "properties": {
            "completeness": { "$ref": "#/$defs/RubricCriterionScore" },
            "correctness": { "$ref": "#/$defs/RubricCriterionScore" },
            "code_quality": { "$ref": "#/$defs/RubricCriterionScore" },
            "intervention_impact": { "$ref": "#/$defs/RubricCriterionScore" },
            "autonomy": { "$ref": "#/$defs/RubricCriterionScore" }
          },
          "required": ["completeness", "correctness", "code_quality", "intervention_impact", "autonomy"],
          "additionalProperties": false
        },
        "determinative_boundary": {
          "type": "string",
          "enum": ["no_interventions", "cosmetic_only", "functional_bug", "multiple_bugs", "heavy_intervention"],
          "description": "Which scoring boundary was the binding constraint on the final score."
        }
      },
      "required": ["schema_version", "rubric_version", "criteria"],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional extensibility bag for additional metadata."
    }
  },
  "$defs": {
    "RubricCriterionScore": {
      "type": "object",
      "description": "Score and rationale for a single rubric criterion.",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Normalized score 0.0–1.0 for this criterion."
        },
        "rationale": {
          "type": "string",
          "description": "1-sentence rationale from the judge."
        }
      },
      "required": ["score", "rationale"],
      "additionalProperties": false
    }
  }
}
